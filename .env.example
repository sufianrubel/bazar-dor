# API Configuration
NEXT_PUBLIC_API_URL=https://api.api-store.workers.dev/api/bazardor
API_FALLBACK_URL=https://api.abcz.workers.dev/api/bazardor

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# BetterAuth
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000

# MongoDB (required by BetterAuth)
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_DB=bazar-dor

# OAuth — optional, if Google/GitHub sign-in is enabled
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Register these callback URLs in the Google and GitHub OAuth app settings.
# Better Auth derives its callback URLs from BETTER_AUTH_URL.
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/callback/google
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/callback/github
